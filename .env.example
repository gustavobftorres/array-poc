# Credenciais da API da Array (obrigatórias para sair do modo mock).
# Copie este arquivo para .env  E  para worker/.dev.vars e preencha.
SMARTY_AUTH_ID=
SMARTY_AUTH_TOKEN=

# Ambiente da Array: sandbox | production
ARRAY_ENV=sandbox

# Aliases aceitos (nomes reais da Array). Use estes OU os SMARTY_* acima.
# ARRAY_APP_KEY=
# ARRAY_CLIENT_TOKEN=
