# Credenciais da API da Array (obrigatórias para sair do modo mock).
#
# ESTE é o arquivo para colar as chaves:
#   cp .env.example .env   → preencha abaixo → npm run dev
#
# O `npm run dev` roda `scripts/sync-env.mjs`, que GERA `worker/.dev.vars`
# a partir deste `.env` (o wrangler só lê de lá). Não precisa copiar nada
# à mão; se quiser, `node scripts/sync-env.mjs` faz a geração isolada.
# SMARTY_AUTH_ID    = Array appKey (UUID de 36 chars, público por design)
# SMARTY_AUTH_TOKEN = Array client token (SEGREDO, fica só no worker)
SMARTY_AUTH_ID=
SMARTY_AUTH_TOKEN=

# Ambiente da Array: sandbox | production
ARRAY_ENV=sandbox

# Aliases aceitos (nomes reais da Array). Use estes OU os SMARTY_* acima.
# ARRAY_APP_KEY=
# ARRAY_CLIENT_TOKEN=
